[grid]
upn = 10
ewn = 31
nsn = 31
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 200.
dt = 5.0
dt_diag = 5.0
idiag = 10
jdiag = 10

[options]
dycore = 0               # 0 = glide
flow_law = 0             # 0 = NOTE: flow_law option needs to be 0 for the test case to work properly
evolution = 2            # 2 = iterated diffusion
temperature = 0          # 0 = isothermal temp.  If temp is turned on, will not affect flwa because flow_law = 0
basal_mass_balance = 0   # 0 = bmlt not in continuity equation

[parameters]
ice_limit = 10.          # min thickness (m) for dynamics
default_flwa = 1.0e-16   #  NOTE: The Halfar testing script requires that default_flwa is supplied here!

[CF default]
comment = created with halfar.py 
title = Halfar test case

[CF input]
name = halfar.nc
time = 1

[CF output]
variables = restart
frequency = 5.
name = halfar.glide.out.nc

