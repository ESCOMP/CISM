[grid]
ewn = 31
nsn = 31
upn = 10
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 200.
dt = 1.

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.

[options]
dycore = 2               # 0 = glide, 1 = glam, 2 = glissade

[numerics]
ice_limit = 1.           # min thickness (m) for dynamics

[velocity]
stokes_approx = 4      # 4 = DIVA
efvs_method = 2        # 0 = constant, 2 = nonlinear eff. visc. w/ n=3
surface_gradient_method = 2    # 0 = centered, 1 = 1st order upstream, 2 = 2nd order upstream

[velocity_solver]
nonlinear_method = 0   # 0 = Picard, 1 = accelerated Picard
linear_solver = 3      # 1 = SLAP GMRES, 3 = glissade parallel PCG
preconditioner = 2     # 1 = diagonal, 2 = physics-based SIA

[advection]
advection_method = 3            # 2 = iterated diffusion, 3 = IR

[temperature]
temperature_method = 0          # 0 = isothermal temp evolution, if turned on, will not affect flwa because default_flwa is specified below.

[flow_law]
flow_law = 0             # 0 = flow_law option needs to be 0 for the test case to work properly.
default_flwa = 1.0e-16   # NOTE: The Halfar testing script requires that flwa is supplied here!

[basal_physics]
sliding_law = 4        # 4 = no-slip at bed

[basal_melt]
basal_mass_balance = 0   # 0 = bmlt not in continuity equation

[calving]
calving_law = 0        # 0 = no calving

[CF default]
comment = created with halfar.py 
title = Halfar test case

[CF input]
name = halfar.nc
time = 1

[CF output]
variables = restart
frequency = 5.
name = halfar.diva.out.nc

