[grid]
ewn = 31
nsn = 31
upn = 10
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 200.
dt = 1.

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.

[options]
dycore = glissade

[numerics]
thcklim = 1.           # min thickness (m) for dynamics

[velocity]
stokes_approx = diva
efvs_method = nonlinear
surface_gradient_method = upstream2

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear
preconditioner = sia

[advection]
advection_method = remap

[temperature]
temperature_method = 0          # 0 = isothermal temp evolution, if turned on, will not affect flwa because flwa_const is specified below.

[flow_law]
flow_law = 0             # 0 = flow_law option needs to be 0 for the test case to work properly.
flwa_const = 1.0e-16   # NOTE: The Halfar testing script requires that flwa is supplied here!

[basal_physics]
sliding_law = 4        # 4 = no-slip at bed

[basal_melt]
basal_mass_balance = 0   # 0 = bmlt not in continuity equation

[calving]
calving_law = 0        # 0 = no calving

[CF default]
comment = created with halfar.py 
title = Halfar test case

[CF input]
name = halfar.nc
time = 1

[CF output]
variables = restart
frequency = 5.
name = halfar.diva.out.nc

