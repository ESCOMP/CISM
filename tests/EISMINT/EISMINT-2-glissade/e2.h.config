# configuration for the EISMINT-2 test-case

[grid]
# grid sizes
ewn = 61
nsn = 61
upn = 11
dew = 25000
dns = 25000

[time]
tend = 200000.
dt = 5.

[diagnostics]
idiag = 31
jdiag = 31
dt_diag = 5000.

[options]
dycore = glissade
basal_water = 1
vertical_integration = 0    # glissade does not support option 1

[numerics]
thcklim = 1.

[velocity]
stokes_approx = local_sia

[velocity_solver]
linear_solver = pcg_chrongear

[advection]
advection_method = remap

[temperature]
temperature_method = prognostic

[flow_law]
flow_law = paterson_budd

[basal_physics]
btrc_method = 2   # could also set slip_coeff = 3 (constant where T = Tpmp)
btrc_const = 1.e-3

[basal_melt]
basal_mass_balance = 0

[calving]
calving_law = 3

[geothermal]
geothermal_flux = -42.e-3

[isostasy]
isostasy = 0

[EISMINT-2]

[CF default]
title: EISMINT-2 Exp H
comment: forced upper kinematic BC

[CF output]
name: e2.h.nc
frequency: 1000
variables: thk bmlt btemp temp ubas vbas uvel vvel wvel wgrd acab diffu bwat

