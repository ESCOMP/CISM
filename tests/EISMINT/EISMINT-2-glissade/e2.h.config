# configuration for the EISMINT-2 test-case

[EISMINT-2]

[grid]
# grid sizes
ewn = 61
nsn = 61
upn = 11
dew = 25000
dns = 25000

[options]
dycore = 2                  # 2 = Glissade
basal_water = 1
vertical_integration = 0    # glissade does not support option 1

[time]
tend = 200000.
dt = 5.
ntem = 1.
dt_diag = 5000.
idiag = 31
jdiag = 31

[calving]
calving_law = 3

[basal_physics]
btrc_method = 2   # could also set slip_coeff = 3 (constant where T = Tpmp)
btrc_const = 1.e-3

[basal_melt]
basal_mass_balance = 0

[velocity]
stokes_approx = -1        # -1 = local SIA

[velocity_solver]
linear_solver = 3         # 3 = parallel PCG

[advection]
advection_method = 3               # 3 = incremental remapping

[flow_law]
flow_law = 2

[temperature]
temperature_method = 1

[geothermal]
geothermal_flux = -42.e-3

[numerics]
ice_limit = 1.

[isostasy]
isostasy = 0

[CF default]
title: EISMINT-2 Exp H
comment: forced upper kinematic BC

[CF output]
name: e2.h.nc
frequency: 1000
variables: thk bmlt btemp temp ubas vbas uvel vvel wvel wgrd acab diffu bwat

