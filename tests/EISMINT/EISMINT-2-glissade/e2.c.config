# configuration for the EISMINT-2 test-case

[grid]
# grid sizes
ewn = 61
nsn = 61
upn = 11
dew = 25000
dns = 25000

[time]
tstart = 200000.
tend   = 400000.
dt = 5.

[diagnostics]
idiag = 31
jdiag = 31
dt_diag = 5000.

[options]
dycore = glissade
basal_water = 1
vertical_integration = 0    # glissade does not support option 1

[numerics]
thcklim = 1.

[velocity]
stokes_approx = local_sia

[velocity_solver]
linear_solver = pcg_chrongear

[advection]
advection_method = remap

[temperature]
temperature_method = prognostic

[flow_law]
flow_law = paterson_budd

[basal_physics]
btrc_method = none

[basal_melt]
basal_mbal_in_continuity = .false.

[calving]
calving_law = relx_threshold

[geothermal]
geothermal_flux = -42.e-3

[isostasy]
compute_isostasy = .false.

[EISMINT-2]
massbalance = 0.25 1.05e-5 425.0e3

[CF default]
title: EISMINT-2 Exp C
comment: forced upper kinematic BC

[CF output]
name: e2.c.nc
frequency: 1000
variables: thk bmlt btemp temp uvel vvel wvel wgrd acab diffu

[CF input]
name: e2.a.restart.nc
time: 2
