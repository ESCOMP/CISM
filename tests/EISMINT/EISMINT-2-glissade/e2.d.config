# configuration for the EISMINT-2 test-case

[grid]
# grid sizes
ewn = 61
nsn = 61
upn = 11
dew = 25000
dns = 25000

[time]
tstart = 200000.
tend   = 400000.
dt = 5.

[diagnostics]
idiag = 31
jdiag = 31
dt_diag = 5000.

[options]
dycore = glissade
basal_water = 1
vertical_integration = 0    # glissade does not support option 1

[numerics]
thcklim = 1.

[velocity]
stokes_approx = -1        # -1 = local SIA

[velocity_solver]
linear_solver = 3         # 3 = parallel PCG

[advection]
advection_method = 3               # 3 = incremental remapping

[temperature]
temperature_method = 1

[flow_law]
flow_law = 2

[basal_physics]
btrc_method = 0

[basal_melt]
basal_mass_balance = 0

[calving]
calving_law = 3

[geothermal]
geothermal_flux = -42.e-3

[isostasy]
isostasy = 0

[EISMINT-2]
massbalance = 0.5 1.05e-5 425.0e3

[CF default]
title: EISMINT-2 Exp D
comment: forced upper kinematic BC

[CF output]
name: e2.d.nc
frequency: 1000
variables: thk bmlt btemp temp uvel vvel wvel wgrd acab diffu

[CF input]
name: e2.a.restart.nc
time: 2
