# configuration for the EISMINT-2 test-case

[grid]
# grid sizes
ewn = 61
nsn = 61
upn = 11
dew = 25000
dns = 25000

[time]
tend = 200000.
dt = 5.

[diagnostics]
idiag = 31
jdiag = 31
dt_diag = 5000.

[options]
dycore = 2                 # 2 = Glissade
basal_water = 1
vertical_integration = 0   # glissade does not support option 1

[numerics]
ice_limit = 1.

[velocity]
stokes_approx = -1        # -1 = local SIA

[velocity_solver]
linear_solver = 3         # 3 = parallel PCG

[advection]
advection_method = 3              # 3 = incremental remapping

[temperature]
temperature_method = 1

[flow_law]
flow_law = 2

[basal_physics]
btrc_method = 0

[basal_melt]
basal_mass_balance = 0

[calving]
calving_law = 3

[geothermal]
geothermal_flux = -42.e-3

[isostasy]
isostasy = 0

[EISMINT-2]

[CF default]
title: EISMINT-2 Exp A
comment: forced upper kinematic BC

[CF output]
name: e2.a.nc
frequency: 1000
variables: thk bmlt btemp temp uvel vvel wvel wgrd acab diffu

[CF restart]
name: e2.a.restart.nc
xtype: double
frequency: 100000
variables: restart
write_init: F

