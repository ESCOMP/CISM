[grid]
upn = 10
ewn = 31
nsn = 31
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 5.
dt = 0.15

[options]
dycore = 2              # 0 = glide, 1 = glam, 2 = glissade

[parameters]
ice_limit = 1.          # min thickness (m) for dynamics

[basal_physics]
sliding_law = 4       # 4 = no-slip at bed

[velocity]
efvs_method = 2       # 0 = constant, 2 = nonlinear eff. visc. w/ n=3

[velocity_solver]
linear_solver = 3     # 1 = SLAP GMRES, 3 = Glissade PCG
nonlinear_method = 0  # 0 = Picard, 1 = accelerated Picard

[advection]
advection_method = 3           # 3 = remapping 

[flow_law]
flow_law = 2            # 0 = constant, 2 = Paterson-Budd

[temperature]
temperature_method = 1         # 1 = prognostic, 3 = enthalpy

[CF default]
comment = created with runTest.py 
title = parabolic dome test case using first-order dynamics and time-dependent forcing 

[CF input]
name = test-forced.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp artm acab
frequency = 0.0001
name = test-forced.out.nc

[CF forcing]
name = test-forcing.nc
