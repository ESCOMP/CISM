[grid]
ewn = 31
nsn = 31
upn = 10
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 10.
dt = 1.

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.

[options]
dycore = glissade

[numerics]
thcklim = 1.          # min thickness (m) for dynamics

[velocity]
stokes_approx = blatter_pattyn
efvs_method = nonlinear

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear
preconditioner = sia

[advection]
advection_method = remap

[temperature]
temperature_method = 1             # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values             

[flow_law]
flow_law = 2                # 0 = isothermal, 2 = temperature dependent

[basal_physics]
sliding_law = 4           # 4 = no-slip at bed

[CF default]
comment = created with runTest.py 
title = parabolic dome test case using first-order dynamics  

[CF input]
name = test.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp
frequency = 1
name = test.out.nc

