[grid]
ewn = 320
nsn = 320
upn = 5
dew = 5000.
dns = 5000.
global_bc = outflow

[time]
tstart = 0.
tend = 1000.0
dt = 1.0
adaptive_cfl_threshold = 0.5

[diagnostics]
idiag = 162
jdiag = 311
dm_dt_diag = gt_per_yr
dt_diag = 1.0

[options]
dycore = glissade
restart_extend_velo = .true.
restart = none

[numerics]
thcklim = 1.                  # min thickness (m) for dynamics

[constants]
rhoi = 917.0                    # ice density
rhoo = 1028.0                   # ocean density
grav = 9.81	                # gravitational acceleration

[velocity]
stokes_approx = diva
efvs_method = nonlinear
surface_gradient_margin_method = marine
surface_gradient_method = centered

[velocity_solver]
nonlinear_method = accelerated_picard
nonlinear_residual = relative_l2norm
nonlinear_maxiters = 50
linear_solver = pcg_chrongear
preconditioner = diagonal
assemble_beta = local
assemble_taud = local
assemble_bfric = local
assemble_lateral = local

[advection]
advection_method = remap

[temperature]
temperature_method = isothermal_artm
temperature_init = file

[flow_law]
flow_law = constant
flwa_const = 2.9377e-18

[basal_physics]
sliding_law = powerlaw
effecpress_method = overburden
powerlaw_c_method = constant
powerlaw_c_const = 10000.       # constant for the power law stress
powerlaw_m = 3.                 # exponent for the power law stress
beta_grounded_min = 1.

[grounding_line]
grounding_line_param = vertices
grounding_line_bmlt = none
flotation_function = linear

[basal_melt]
bmlt_float_method = none
basal_mbal_in_continuity = .false.

[calving]
calving_law = advance_retreat_rate
apply_calving_mask = False  # if true, apply a calving mask at the margin
subgrid_calving_front = .true.
thck_effective_min = 50.
dthck_dx_cf = 0.0001            # surface slope at the CF
cf_advance_retreat_amplitude = 0.
cf_advance_retreat_period = 0.

[climate]
smb_input_units = 0           # 0 = m/yr ice, 1 = mm/yr w.e.

[geothermal]
geothermal_flux = 0.

[CF default]
comment = created with calvingMIP.Setup.py
title = calvingMIP experiment using CISM

[CF input]
name = calvingMIP.input.nc
time = 1

[CF output]
variables = thk topg usurf uvel vvel beta_internal effecpress f_ground f_flotation floating_mask grounded_mask usfc vsfc ubas vbas uvel_mean vvel_mean stagthk ivol imass_above_flotation iareag calving_thck subgrid_calving_mask
frequency = 1000.0
name = calvingMIP.out.nc

[CF restart]
variables = restart
xtype = double
frequency = 1000.0
name = calvingMIP.restart.nc
write_init = F

