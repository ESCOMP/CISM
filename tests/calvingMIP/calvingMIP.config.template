[grid]
upn = 5
ewn = 320
nsn = 320
dew = 5000.
dns = 5000.
global_bc = 1     # 1 = outflow BCs

[time]
tstart = 0.
tend = 1000.0
dt = 1.0
dt_diag = 1.0
adaptive_cfl_threshold = 0.5
idiag = 162
jdiag = 311

[options]
dycore = 2              # 0 = glide, 2 = glissade
evolution = 3           # 3 = remapping, 4 = first order upwind
flow_law = 0            # 0 = constant, 2 = Paterson-Budd
temperature = 0         # 0 = sfc air temp, 1 = prognostic
temp_init = 4           # 4 = read from external file
dm_dt_diag = 1          # 0 = kg/s, 1 = Gt/yr
restart_extend_velo = 1 # 1 = write uvel/vvel on extended grid
restart = 0             # 0 = no restart, 1 = standard restart, 2 = hybrid restart

[parameters]
rhoi = 917.0                    # ice density
rhoo = 1028.0                   # ocean density
grav = 9.81	                # gravitational acceleration
ice_limit = 1.                  # min thickness (m) for dynamics
default_flwa = 2.9377e-18
geothermal = 0.

[calving]
calving_law = 6       # 5 = calving mask, 6 = prescribed advance/retreat rate
apply_calving_mask = False  # if true, apply a calving mask at the margin
subgrid_calving_front = 1        # 0 = no subgrid calving front, 1 = subgrid calving front
thck_effective_min = 50.
dthck_dx_cf = 0.0001            # surface slope at the CF
cf_advance_retreat_amplitude = 0.
cf_advance_retreat_period = 0.

[climate]
smb_input = 0           # 0 = m/yr ice, 1 = mm/yr w.e.

[basal_physics]
sliding_law = 9                 # 9 = power law
effecpress_method = 0           # 0 = overburden
powerlaw_c_method = 0           # 0 = spatially uniform constant
powerlaw_c_const = 10000.       # constant for the power law stress
powerlaw_m = 3.                 # exponent for the power law stress
beta_grounded_min = 1.

[grounding_line]
grounding_line_param = 1               # 0 = no GLP, 1 = GLP
grounding_line_bmlt = 0          # 0 = no bmlt GLP, 1 = bmlt GLP
flotation_function = 2   # 0 = f_pattyn, 2 = linear

[basal_melt]
basal_mass_balance = 0  # 1 = include basal mass balance in continuity eqn
bmlt_float_method = 0          # 0 = no melting of floating ice

[velocity]
efvs_method = 2                 # 0 = constant, 2 = nonlinear eff. visc. w/ n=3
stokes_approx = 4               # 1 = SSA, 2 = Blatter-Pattyn, 3 = L1L2, 4 = DIVA
surface_gradient_margin_method = 2      # 2 = marine BC
surface_gradient_method = 0             # 0 = centered, 1 = upstream

[velocity_solver]
linear_solver = 3               # 1 = SLAP GMRES, 3 = Fortran PCG
nonlinear_method = 1            # 0 = Picard, 1 = accelerated Picard
preconditioner = 1              # 1 = diagonal precond, 2 = shallow ice preconditioner
assemble_beta = 1        # 0 = standard FE, 1 = local
assemble_taud = 1        # 0 = standard FE, 1 = local
assemble_bfric = 1       # 0 = standard FE, 1 = local
assemble_lateral = 1     # 1 = local assembly applied at the marine boundary
nonlinear_residual = 4                # 3 = absolute, 4 = relative
nonlinear_maxiters = 50

[CF default]
comment = created with calvingMIP.Setup.py
title = calvingMIP experiment using CISM

[CF input]
name = calvingMIP.input.nc
time = 1

[CF output]
variables = thk topg usurf uvel vvel beta_internal effecpress f_ground f_flotation floating_mask grounded_mask usfc vsfc ubas vbas uvel_mean vvel_mean stagthk ivol imass_above_flotation iareag calving_thck subgrid_calving_mask
frequency = 1000.0
name = calvingMIP.out.nc

[CF restart]
variables = restart
xtype = double
frequency = 1000.0
name = calvingMIP.restart.nc
write_init = F

