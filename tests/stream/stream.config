[grid]
upn = 2
ewn = 15
nsn = 31
dew = 2000.0
dns = 2000.0

[time]
tstart = 0.0
tend = 0.0
dt = 1.0 

[options]
dycore = 2                  # 1 = glam, 2 = glissade

[basal_physics]
sliding_law = 15          # till yield stress map taken from .nc input 
beta_grounded_min = 0.

[velocity]
efvs_method = 2           # nonlinear eff. visc. w/ n=3
stokes_approx = 2         # 1 = SSA, 2 = Blatter-Pattyn, 3 = L1L2

[velocity_solver]
linear_solver = 3         # 1 = SLAP GMRES, 3 = glissade parallel PCG
nonlinear_method = 0      # 0 = Picard, 1 = accelerated Picard
preconditioner = 1        # 0 = none, 1 = diagonal, 2 = SIA based (ONLY use for which_ho_approx = 2)
assemble_beta = 1  # 0=smoothed by FEM assembly, 1 = local approx.
nonlinear_maxiters = 300      # max. no. of nonlinear (Picard) iterations for Glissade

[advection]
advection_method = 3               # 3 = inc. remapping, 4 = FO upwind

[flow_law]
flow_law = 0                # 0 = isothermal, 2 = temperature dependent

[numerics]
periodic_offset_ew = 30.0

[CF default]
comment = none
title = simple ice stream - yield stress set for analytical solution

[CF input]
name = stream.nc 
time = 1

[CF output]
variables = usrf topg thk flwa uvel vvel velnorm tauf
frequency = 1
name = stream.out.nc
xtype = double
