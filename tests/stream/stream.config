[grid]
ewn = 15
nsn = 31
upn = 2
dew = 2000.0
dns = 2000.0

[time]
tstart = 0.0
tend = 0.0
dt = 1.0 

[options]
dycore = glissade

[numerics]
periodic_offset_ew = 30.0

[velocity]
stokes_approx = blatter_pattyn
efvs_method = nonlinear           # nonlinear eff. visc. w/ n=3

[velocity_solver]
nonlinear_method = picard
nonlinear_maxiters = 300      # max. no. of nonlinear (Picard) iterations for Glissade
linear_solver = pcg_chrongear
preconditioner = diagonal
assemble_beta = local

[advection]
advection_method = remap

[flow_law]
flow_law = constant

[basal_physics]
sliding_law = yield_picard   # till yield stress map taken from .nc input
beta_grounded_min = 0.

[CF default]
comment = none
title = simple ice stream - yield stress set for analytical solution

[CF input]
name = stream.nc 
time = 1

[CF output]
variables = usrf topg thk flwa uvel vvel velnorm tauf
frequency = 1
name = stream.out.nc
xtype = double
