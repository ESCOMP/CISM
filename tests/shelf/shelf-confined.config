[grid]
ewn = 43
nsn = 44
upn = 5
dew = 5000.0
dns = 5000.0

[time]
tstart = 0.
tend = 0.
dt = 1.

[diagnostics]
idiag = 22
jdiag = 10
dt_diag = 1.

[options]
dycore = glissade

[velocity]
stokes_approx = blatter_pattyn
efvs_method = nonlinear
surface_gradient_margin_method = marine

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear
preconditioner = sia

[advection]
advection_method = remap

[temperature]
temperature_method = isothermal_artm

[flow_law]
flow_law = constant
flwa_const = 5.7e-18

[basal_physics]
sliding_law = beta_file
beta_grounded_min = 0.

[calving]
calving_law = 0       # 0 = do nothing

[CF default]
comment = Same as experiment 3 from EISMINT-shelf
title = Confined Shelf Experiment (first-order dynamics)

[CF input]
name = shelf-confined.nc
time = 1

[CF output]
variables = thk uvel vvel velnorm
frequency = 1
name = shelf-confined.out.nc

