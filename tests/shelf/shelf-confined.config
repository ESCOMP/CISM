[grid]
ewn = 43
nsn = 44
upn = 5
dew = 5000.0
dns = 5000.0

[time]
tstart = 0.
tend = 0.
dt = 1.

[diagnostics]
idiag = 22
jdiag = 10
dt_diag = 1.

[options]
dycore = 2              # 1 = glam, 2 = glissade

[velocity]
stokes_approx = 2     # 1 = SSA, 2 = Blatter-Pattyn, 3 = L1L2
efvs_method = 2       # 2 = nonlinear eff. visc. w/ n=3
surface_gradient_margin_method = 2  # 0 = land BC, 1 = hybrid BC, 2 = shelf BC

[velocity_solver]
nonlinear_method = 0  # 0 = Picard, 1 = accelerated Picard
linear_solver = 3     # 1 = SLAP GMRES, 3 = glissade parallel PCG
preconditioner = 2    # 0 = none, 1 = diagonal, 2 = SIA based (ONLY use for which_ho_approx = 2)

[advection]
advection_method = 3           # 3 = inc. remapping, 4 = FO upwind

[temperature]
temperature_method = 0         # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values

[flow_law]
flow_law = 0            # 0 = isothermal, 2 = temperature dependent
default_flwa = 5.7e-18

[basal_physics]
sliding_law = 5       # 5 = take basal traction param value from .nc input
beta_grounded_min = 0.

[calving]
calving_law = 0       # 0 = do nothing

[CF default]
comment = Same as experiment 3 from EISMINT-shelf
title = Confined Shelf Experiment (first-order dynamics)

[CF input]
name = shelf-confined.nc
time = 1

[CF output]
variables = thk uvel vvel velnorm
frequency = 1
name = shelf-confined.out.nc

