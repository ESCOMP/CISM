[grid]
ewn = 43
nsn = 44
upn = 5
dew = 5000.0
dns = 5000.0

[time]
tstart = 0.
tend = 0.
dt = 1.

[diagnostics]
idiag = 22
jdiag = 10
dt_diag = 1.

[options]
dycore = glissade

[velocity]
stokes_approx = blatter_pattyn
efvs_method = nonlinear
surface_gradient_margin_method = marine

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear
preconditioner = sia

[advection]
advection_method = remap

[temperature]
temperature_method = 0         # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values

[flow_law]
flow_law = 0            # 0 = isothermal, 2 = temperature dependent
flwa_const = 5.7e-18

[basal_physics]
sliding_law = 5       # 5 = take basal traction param value from .nc input
beta_grounded_min = 0.

[calving]
calving_law = 0       # 0 = do nothing

[CF default]
comment = Same as experiment 3 from EISMINT-shelf
title = Confined Shelf Experiment (first-order dynamics)

[CF input]
name = shelf-confined.nc
time = 1

[CF output]
variables = thk uvel vvel velnorm
frequency = 1
name = shelf-confined.out.nc

