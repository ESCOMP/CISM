[grid]
ewn = 41
nsn = 41
upn = 5
dew = 1250.0
dns = 1250.0

[time]
tstart = 0.
tend = 0.
dt = 1.0

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.0

[options]
dycore = glissade

[velocity]
stokes_approx = blatter_pattyn
efvs_method = nonlinear

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear
preconditioner = sia

[advection]
advection_method = remap

[temperature]
temperature_method = 0         # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values

[flow_law]
flow_law = 0            # 0 = isothermal, 2 = temperature dependent
flwa_const = 5.7e-18

[basal_physics]
sliding_law = 5       # 5 = take basal traction param value from .nc input
beta_grounded_min = 0.

[calving]
calving_law = 0       # 0 = do nothing

[CF default]
comment = created by runShelfCircular.py
title = Circular Shelf Experiment (first-order dynamics)

[CF input]
name = shelf-circular.nc
time = 1

[CF output]
variables = thk uvel vvel velnorm flwa topg lsurf
frequency = 1
name = shelf-circular.out.nc

