[grid]
upn = 10
ewn = 31
nsn = 31
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 10.
dt = 1.
dt_diag = 1.
idiag = 10
jdiag = 10

[options]
dycore = 0                  # 0 = glide
flow_law = 2                # 0 = isothermal, 2 = temperature dependent
evolution = 2               # 2 = diffusion-based
temperature = 1             # 0 = set column to surface air temp, 1 = prognostic
temp_init = 1               # 1 = init to surface air temp
slip_coeff = 1              # 1 = uniform basal traction coeff

[parameters]
ice_limit = 100.            # min thickness (m) for dynamics
basal_tract_const = 1.e-4   # (m/yr)/Pa; larger => lower traction

[CF default]
comment = created with runDome.py 
title = parabolic dome test case using Glide SIA solver

[CF input]
name = dome.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp btemp
frequency = 1
name = dome.out.nc

