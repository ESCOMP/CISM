[grid]
upn = 10
ewn = 31
nsn = 31
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 10.
dt = 1.
dt_diag = 1.
idiag = 10
jdiag = 10

[options]
dycore = 2                  # 1 = glam, 2 = glissade
flow_law = 2                # 0 = isothermal, 2 = temperature dependent
evolution = 3               # 3 = inc. remapping, 4 = FO upwind
temperature = 1             # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values             

[parameters]
ice_limit = 1.              # min thickness (m) for dynamics

[basal_physics]
sliding_law = 4           # 4 = no-slip at bed

[velocity]
stokes_approx = 3         # 3 = L1L2
efvs_method = 2           # 2 = nonlinear eff. visc. w/ n=3

[velocity_solver]
linear_solver = 3         # 1 = SLAP GMRES, 3 = glissade parallel PCG
nonlinear_method = 0      # 0 = Picard, 1 = accelerated Picard

[CF default]
comment = created with runDome.py
title = parabolic dome test case using L1L2 solver

[CF input]
name = dome.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp
frequency = 1
name = dome.out.nc

