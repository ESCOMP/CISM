[grid]
ewn = 31
nsn = 31
upn = 10
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 10.
dt = 1.

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.

[options]
dycore = 2                  # 1 = glam, 2 = glissade

[numerics]
ice_limit = 1.              # min thickness (m) for dynamics

[velocity]
stokes_approx = 1         # 1 = SSA
efvs_method = 2           # 2 = nonlinear eff. visc. w/ n=3

[velocity_solver]
nonlinear_method = 0      # 0 = Picard, 1 = accelerated Picard
linear_solver = 3         # 1 = SLAP GMRES, 3 = glissade parallel PCG

[advection]
advection_method = 3               # 3 = inc. remapping, 4 = FO upwind

[temperature]
temperature_method = 1             # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values             

[flow_law]
flow_law = 2                # 0 = isothermal, 2 = temperature dependent

[basal_physics]
sliding_law = 0           # 0 = uniform
beta_const = 10000.

[CF default]
comment = created with runDome.py
title = parabolic dome test case using SSA solver

[CF input]
name = dome.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp
frequency = 1
name = dome.out.nc

