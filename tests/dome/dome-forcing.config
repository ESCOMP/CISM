[grid]
ewn = 31
nsn = 31
upn = 10
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 5.
dt = 0.15

[options]
dycore = 2              # 0 = glide, 1 = glam, 2 = glissade

[numerics]
thcklim = 1.          # min thickness (m) for dynamics

[velocity]
stokes_approx = 2           # 2 = Blatter-Pattyn (the default before the config reorganization)
efvs_method = 2       # 0 = constant, 2 = nonlinear eff. visc. w/ n=3

[velocity_solver]
nonlinear_method = 0  # 0 = Picard, 1 = JFNK
linear_solver = 3     # 1 = SLAP GMRES, 3 = Glissade PCG
preconditioner = 2          # 2 = SIA (the default before the config reorganization)

[advection]
advection_method = 3           # 3 = remapping 

[temperature]
temperature_method = 1         # 1 = prognostic, 3 = enthalpy

[flow_law]
flow_law = 2            # 0 = constant, 2 = Paterson-Budd

[basal_physics]
sliding_law = 4       # 4 = no-slip at bed

[CF default]
comment = created with dome.py 
title = parabolic dome test case using first-order dynamics and time-dependent forcing 

[CF input]
name = dome-forced.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp artm acab
frequency = 0.0001
name = dome-forced.out.nc

# An example of how to use a forcing file.
# This file is generated by dome.forcing.py
# which needs to be run before using this config file.
[CF forcing]
name = dome-forcing.nc
