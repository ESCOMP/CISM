[grid]
ewn = 31
nsn = 31
upn = 10
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 10.
dt = 1.

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.

[options]
dycore = glissade

[numerics]
thcklim = 1.              # min thickness (m) for dynamics

[velocity]
stokes_approx = diva
efvs_method = nonlinear
diva_slope_correction = .false.

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear

[advection]
advection_method = remap

[temperature]
temperature_method = prognostic

[flow_law]
flow_law = paterson_budd

[basal_physics]
sliding_law = no_slip

[CF default]
comment = created with runDome.py
title = parabolic dome test case using DIVA solver

[CF input]
name = dome.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp
frequency = 1
name = dome.out.nc

