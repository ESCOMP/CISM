[grid]
ewn = 30
nsn = 5
upn = 20
dew = 50
dns = 50

[time]
tstart = 0.
tend = 0.
dt = 0.01

[diagnostics]
idiag = 15
jdiag = 5
dt_diag = 0.01

[options]
dycore = glissade

[numerics]
thcklim = 1.          # min thickness (m) for dynamics

[velocity]
stokes_approx = diva
diva_slope_correction = .true.  # if true, apply slope correction so DIVA resembles BP

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear

[advection]
advection_method = remap

[temperature]
temperature_method = prognostic

[flow_law]
flow_law = constant

[basal_physics]
sliding_law = beta_file

[basal_melt]
basal_mass_balance = 0  # 0 = basal mbal not in continuity eqn

[geothermal]
geothermal_flux = 0.

[CF default]
comment = created with slab.py
title = inclined slab test case for higher-order dynamics

[CF input]
name = slab.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm topg beta
frequency = 1
name = slab.out.nc
