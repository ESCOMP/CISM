[grid]
upn = 20
ewn = 30
nsn = 5
dew = 50
dns = 50

[time]
tstart = 0.
tend = 0.
dt = 0.01
dt_diag = 0.01
idiag = 15
jdiag = 5

[options]
dycore = 2              # 2 = glissade

[basal_physics]
sliding_law = 5       # 5 = externally-supplied beta(required by test case)

[basal_melt]
basal_mass_balance = 0  # 0 = basal mbal not in continuity eqn

[velocity]
stokes_approx = 4     # 2 = BP, 3 = L1L2, 4 = DIVA
diva_slope_correction = .true.  # if true, apply slope correction so DIVA resembles BP

[velocity_solver]
linear_solver = 3     # 1 = SLAP GMRES, 3 = glissade parallel PCG
nonlinear_method = 0  # 0 = Picard, 1 = accelerated Picard

[advection]
advection_method = 3           # 3 = remapping

[flow_law]
flow_law = 0            # 0 = constant flwa (default = 1.e-16 Pa-n yr-1)

[temperature]
temperature_method = 1         # 1 = prognostic

[geothermal]
geothermal_flux = 0.

[numerics]
ice_limit = 1.          # min thickness (m) for dynamics

[CF default]
comment = created with slab.py
title = inclined slab test case for higher-order dynamics

[CF input]
name = slab.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm topg beta
frequency = 1
name = slab.out.nc
