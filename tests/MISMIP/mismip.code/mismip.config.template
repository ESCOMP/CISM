[grid]
upn = 3
ewn = 1000
nsn = 5
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 20000.
dt = 1.
adaptive_cfl_threshold = 0.5

[options]
dycore = 2              # 0 = glide, 1 = glam, 2=glissade
restart_extend_velo = 1 # 1 = write uvel/vvel on extended grid
# restart = 0

[numerics]
ice_limit = 1.                 ; min thickness (m) for dynamics

[constants]
rhoi = 900.0            # MISMIP ice density
rhoo = 1000.0           # MISMIP ocean density
grav = 9.80             # MISMIP gravitational acceleration

[velocity]
efvs_method = 2               # 0 = constant, 2 = nonlinear eff. visc. w/ n=3
stokes_approx = 1             # 1 = SSA, 2 = Blatter-Pattyn, 3 = L1L2, 4 = DIVA
surface_gradient_margin_method = 2    # 2 = marine BC
surface_gradient_method = 0            # 0 = centered, 1 = upstream

[velocity_solver]
linear_solver = 3             # 1 = SLAP GMRES, 3 = Fortran PCG
nonlinear_method = 0          # 0 = Picard, 1 = accelerated Picard
preconditioner = 1            # 1 = diagonal precond, 2 = shallow ice preconditioner
assemble_beta = 1       # 0 = standard FE, 1 = local
assemble_taud = 1       # 0 = standard FE, 1 = local
nonlinear_residual = 4               # 3 = absolute, 4 = relative
nonlinear_maxiters = 50
assemble_lateral = 0        # 0 = standard (the default before the config reorganization)

[advection]
advection_method = 3           # 3 = remapping, 4 = first order upwind

[temperature]
temperature_method = 0         # 1 = prognostic, 3 = enthalpy

[flow_law]
flow_law = 0            # 0 = constant, 2 = Paterson-Budd
flow_factor_ground = 1.
flow_factor_float = 1.
default_flwa = 1.0e-17

[basal_physics]
sliding_law = 9              # 4 = no-slip at bed, 10 = Coulomb friction law, 11 = Coulomb w/const basal flwa
effecpress_method = 0         # 0 = overburden; the ocean connection is set by p_ocean_penetration
powerlaw_m = 3
powerlaw_c_const = 2.4131e4
coulomb_c_const = 0.1778
coulomb_bump_max_slope = 0.5    ; maximum bed obstacle slope
coulomb_bump_wavelength = 2.0
p_ocean_penetration = 0      ; p values for coulomb friction law

[grounding_line]
flotation_function = 0  # 0 = fpattyn, 1 = 1/fpattyn, 2 = ocean cavity thickness
grounding_line_param = 1              # 0 = no GLP, 1 = GLP

[basal_melt]
bmlt_float_method = 0          # 0 = no melting of floating ice

[calving]
calving_law = 4       # 4 = topographic threshold, 5 = calving mask
marine_limit = -1250           ; depth past which ice is lost

[CF default]
comment = created with mismipInit.py 
title = MISMIP experiment using CISM2

[CF input]
name = mismipInit.restart.nc 
time = 1

[CF output]
#variables = restart effec_press beta resid_u resid_v f_ground f_flotation btractx btracty taudx taudy tau_xx
variables = thk usurf uvel vvel temp beta_internal topg flwa effec_press beta resid_u resid_v f_ground f_flotation floating_mask grounded_mask usfc vsfc ubas vbas uvel_mean vvel_mean stagthk ivol imass_above_flotation iareag btractx btracty taudx taudy tau_xx
frequency = 500
name = mismip.out.nc

[CF restart]
variables = restart
xtype = double
frequency = 1000
name = mismip.restart.nc
