[grid]
ewn = 324
nsn = 40
upn = 3
dew = 2000
dns = 2000

[time]
tstart = 0.
tend = 15000.
dt = 1
#idiag = 5
#jdiag = 5

[options]
dycore = glissade
restart_extend_velo = .true.
# restart = 1

[numerics]
thcklim = 1.                  ; min thickness (m) for dynamics

[constants]
rhoi = 900.0                    ; MISMIP ice density
rhoo = 1000.0                   ; MISMIP ocean density
grav = 9.8                      ; MISMIP gravitational acceleration

[velocity]
stokes_approx = ssa
efvs_method = nonlinear
surface_gradient_margin_method = marine
surface_gradient_method = centered

[velocity_solver]
nonlinear_method = picard
nonlinear_residual = relative_l2norm
nonlinear_maxiters = 50
linear_solver = pcg_chrongear
preconditioner = diagonal
assemble_beta = local
assemble_taud = local
assemble_lateral = standard

[advection]
advection_method = remap

[temperature]
temperature_method = isothermal_artm

[flow_law]
flow_law = constant
flow_factor_ground = 1.
flow_factor_float = 1.
flwa_const = 3.1536e-18

[basal_physics]
sliding_law = coulomb
use_c_space_factor = .true.     # beta is multiplied by c_space_factor (the P75S friction perturbation)
effecpress_method = overburden
coulomb_c_const = 0.2332
coulomb_bump_max_slope = 0.5    ; maximum bed obstacle slope
coulomb_bump_wavelength = 2.0   ; bedrock wavelength
flwa_basal_const = 1.0e-16      ; flow factor at the bed (Pa^-3 yr^-1)
p_ocean_penetration = 0.        ; p values for coulomb friction law

[grounding_line]
grounding_line_param = vertices
flotation_function = pattyn

[basal_melt]
bmlt_float_method = 0               # 0 = no melting of floating ice
basal_mass_balance = 1       # 1 = include basal mass balance in continuity eqn

[calving]
calving_law = 4            # 4 = topographic threshold, 5 = calving mask
marine_limit = -890             ; depth past which ice is lost

[CF default]
comment = created with mismip3dInit.py 
title = MISMIP3d experiment using CISM2

[CF input]
name = mismip3dInit.nc
time = 1

[CF output]
variables = thk usurf uvel vvel velnorm temp beta_internal topg flwa effec_press beta resid_u resid_v f_ground f_flotation floating_mask grounded_mask usfc vsfc ubas vbas uvel_mean vvel_mean stagthk ivol imass_above_flotation iareag btractx btracty taudx taudy tau_xx
frequency = 1000
name = mismip3d.out.nc

[CF restart]
variables = restart
xtype = double
frequency = 2000
name = mismip3d.restart.nc
