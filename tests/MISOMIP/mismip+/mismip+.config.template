[grid]
ewn = 324
nsn = 40
upn = 5
dew = 2000
dns = 2000
global_bc = periodic

[time]
tstart = 0.
tend = 20000.0
dt = 0.5
#idiag = 5
#jdiag = 5

[diagnostics]
idiag = 1               # set by mismip+Setup.py
jdiag = 1               # set by mismip+Setup.py
dt_diag = 0.5

[options]
dycore = glissade
restart_extend_velo = .true.
restart = none

[numerics]
thcklim = 1.                  #min thickness (m) for dynamics

[constants]
rhoi = 918.0            # MISMIP+ ice density
rhoo = 1028.0           # MISMIP+ ocean density
grav = 9.8              # MISMIP+ gravitational acceleration

[velocity]
stokes_approx = diva
efvs_method = nonlinear
surface_gradient_margin_method = marine
surface_gradient_method = centered

[velocity_solver]
nonlinear_method = accelerated_picard
nonlinear_residual = relative_l2norm
nonlinear_maxiters = 50
linear_solver = pcg_chrongear
preconditioner = diagonal
assemble_beta = local
assemble_taud = local
assemble_bfric = local
assemble_lateral = local

[advection]
advection_method = remap

[temperature]
temperature_method = isothermal_artm

[flow_law]
flow_law = constant
flow_factor_ground = 1.
flow_factor_float = 1.
flwa_const = 2.0e-17

[basal_physics]
sliding_law = 11                # 11 = Coulomb w/const basal flwa, 12 = Tsai law, 9 = power law
beta_grounded_min = 10.
p_ocean_penetration = 1.        # p value for Coulomb friction law
coulomb_c_const = 0.5
powerlaw_c_const = 1.e4         # constant for the power law stress
powerlaw_m = 3                  # exponent for the power law stress

[grounding_line]
grounding_line_param = 1               # 0 = no GLP, 1 = GLP
grounding_line_bmlt = 0          # 0 = no bmlt GLP, 1 = bmlt GLP
flotation_function = 2   # 0 = f_pattyn, 2 = linear

[basal_melt]
bmlt_float_method = 0          # 0 = no melting of floating ice, 1 = Ice1 melting, 2 = Ice2 melting
basal_mass_balance = 1  # 1 = include basal mass balance in continuity eqn
bmlt_float_omega = 0.2          # parameter for Ice1
bmlt_float_z0 = -100.           # parameter for Ice1
bmlt_float_h0 = 75.             # parameter for Ice1
bmlt_float_const = 100.         # parameter for Ice2
bmlt_float_xlim = 480000.       # parameter for Ice2

[calving]
calving_law = 5       # 4 = topographic threshold, 5 = calving mask
calving_front_x = 640000.       # 640 km for mismip+

[CF default]
comment = created with mismip+Init.py 
title = MISMIP+ experiment using CISM

[CF input]
name = mismip+Init.nc
time = 1

[CF output]
variables = thk topg usurf uvel vvel beta_internal effecpress f_ground f_flotation floating_mask grounded_mask usfc vsfc ubas vbas uvel_mean vvel_mean stagthk ivol imass_above_flotation iareag calving_thck
frequency = 1000
name = mismip+.out.nc

[CF restart]
variables = restart
xtype = double
frequency = 1000
name = mismip+.restart.nc
write_init = F

