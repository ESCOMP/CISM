[grid]
# x and y dimensions are one more than the raw data, 
# because we are choosing to use the raw data on the velocity grid.
ewn = 148
nsn = 112
upn = 11
dew = 6822
dns = 6822

[time]
tstart = 0.
tend = 0.
dt = 1.

[diagnostics]
idiag = 80
jdiag = 30
dt_diag = 1.

[options]
dycore = glissade

[velocity]
stokes_approx = ssa
efvs_method = nonlinear

[velocity_solver]
nonlinear_method = picard
nonlinear_maxiters = 300  # max. no. of nonlinear (Picard) iterations for Glissade
linear_solver = pcg_chrongear
preconditioner = diagonal
assemble_lateral = standard

[advection]
advection_method = remap

[temperature]
temperature_method = isothermal_artm

[flow_law]
flow_law = constant
flwa_const = 4.6e-18

[basal_physics]
sliding_law = beta_file

[calving]
calving_law = relx_threshold

[CF default]
title = EISMINT-Ross Benchmark Experiment 

[CF input]
name = ross.nc
time = 1

[CF output]
variables = thk uvel vvel wvel velnorm
frequency = 1
name = ross.out.nc
