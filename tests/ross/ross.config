[grid]
upn = 11
# x and y dimensions are one more than the raw data, 
# because we are choosing to use the raw data on the velocity grid.
ewn = 148
nsn = 112
dew = 6822
dns = 6822

[time]
tstart = 0.
tend = 0.
dt = 1.

[diagnostics]
dt_diag = 1.
idiag = 80
jdiag = 30

[options]
dycore = 2              # 1 = glam, 2 = glissade

[velocity]
efvs_method = 2       # 2 = nonlinear eff. visc. w/ n=3
stokes_approx = 1     # 1 = SSA, 2 = Blatter-Pattyn, 3 = L1L2

[velocity_solver]
linear_solver = 3     # 1 = SLAP GMRES, 3 = glissade parallel PCG
nonlinear_method = 0  # 0 = Picard, 1 = accelerated Picard
preconditioner = 1    # 0 = none, 1 = diagonal, 2 = SIA based (ONLY use for which_ho_approx = 2)
nonlinear_maxiters = 300  # max. no. of nonlinear (Picard) iterations for Glissade
assemble_lateral = 0        # 0 = standard (the default before the config reorganization)

[advection]
advection_method = 3           # 3 = inc. remapping, 4 = FO upwind

[temperature]
temperature_method = 0         # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values

[flow_law]
flow_law = 0            # 0 = isothermal, 2 = temperature dependent
default_flwa = 4.6e-18

[basal_physics]
sliding_law = 5       # 5 = take basal traction param value from .nc input

[calving]
calving_law = 3       # 3 = threshold from relaxed bedrock

[CF default]
title = EISMINT-Ross Benchmark Experiment 

[CF input]
name = ross.nc
time = 1

[CF output]
variables = thk uvel vvel wvel velnorm
frequency = 1
name = ross.out.nc
