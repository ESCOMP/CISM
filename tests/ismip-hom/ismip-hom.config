# Test from ISMIP-HOM higher-order test suite
# see: Pattyn et al., The Cryosphere, 2, 95–108, 2008.
# www.the-cryosphere.net/2/95/2008
# http://homepages.ulb.ac.be/~fpattyn/ismip/ismiphom.pdf

[grid]
ewn = 40    
nsn = 40
upn = 11
dew = 4000   
dns = 4000   

[time]
tstart = 0.
tend = 0.
dt = 1.

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.

[options]
dycore = 2                  # 1 = glam, 2 = glissade

[velocity]
stokes_approx = 4         # 4 = DIVA
efvs_method = 2           # 2 = nonlinear eff. visc. w/ n=3

[velocity_solver]
nonlinear_method = 0      # 0 = Picard, 1 = accelerated Picard
linear_solver = 3         # 1 = SLAP GMRES, 3 = glissade parallel PCG
assemble_beta = 1  # 0=smoothed by FEM assembly, 1 = local approx.

[advection]
advection_method = 3               # 3 = inc. remapping, 4 = FO upwind

[temperature]
temperature_method = 0             # 0 = set column to surf. air temp, 1 = prognostic, 2 = hold at init. values

[flow_law]
flow_law = 0                # 0 = isothermal, 2 = temperature dependent

[basal_physics]
sliding_law = 4           # 4 = no-slip at bed; 5 = beta field from .nc input
beta_grounded_min = 0.

[CF default]
comment = generated by runISMIPHOM.py
title = ISMIP-HOM Experiment 

[CF input]
name = ismip-hom.nc
time = 1

[CF output]
variables = uvel vvel uvel_extend vvel_extend topg thk usurf wvel velnorm
frequency = 1
name = ismip-hom.out.nc

