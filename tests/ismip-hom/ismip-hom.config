# Test from ISMIP-HOM higher-order test suite
# see: Pattyn et al., The Cryosphere, 2, 95–108, 2008.
# www.the-cryosphere.net/2/95/2008
# http://homepages.ulb.ac.be/~fpattyn/ismip/ismiphom.pdf

[grid]
ewn = 40    
nsn = 40
upn = 11
dew = 4000   
dns = 4000   

[time]
tstart = 0.
tend = 0.
dt = 1.

[diagnostics]
idiag = 10
jdiag = 10
dt_diag = 1.

[options]
dycore = glissade

[velocity]
stokes_approx = diva
efvs_method = nonlinear

[velocity_solver]
nonlinear_method = picard
linear_solver = pcg_chrongear
assemble_beta = local

[advection]
advection_method = remap

[temperature]
temperature_method = isothermal_artm

[flow_law]
flow_law = constant

[basal_physics]
sliding_law = 4           # 4 = no-slip at bed; 5 = beta field from .nc input
beta_grounded_min = 0.

[CF default]
comment = generated by runISMIPHOM.py
title = ISMIP-HOM Experiment 

[CF input]
name = ismip-hom.nc
time = 1

[CF output]
variables = uvel vvel uvel_extend vvel_extend topg thk usurf wvel velnorm
frequency = 1
name = ismip-hom.out.nc

